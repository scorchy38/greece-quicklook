    "Not Authenticode signed. Windows SmartScreen warns before running unsigned downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht Authenticode-signiert. Windows SmartScreen warnt vor dem Ausführen unsignierter Downloads."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς υπογραφή Authenticode. Το Windows SmartScreen προειδοποιεί πριν από την εκτέλεση μη υπογεγραμμένων λήψεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firma Authenticode. Windows SmartScreen avisa antes de ejecutar descargas sin firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non signé avec Authenticode. Windows SmartScreen avertit avant d’exécuter les téléchargements non signés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza firma Authenticode. Windows SmartScreen avvisa prima di eseguire download non firmati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode署名がありません。Windows SmartScreenは、署名のないダウンロードを実行する前に警告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode로 서명되지 않았습니다. Windows SmartScreen은 서명되지 않은 다운로드 파일을 실행하기 전에 경고합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet Authenticode-ondertekend. Windows SmartScreen waarschuwt voordat niet-ondertekende downloads worden uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu Authenticode. Windows SmartScreen ostrzega przed uruchomieniem niepodpisanych pobranych plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura Authenticode. O Windows SmartScreen avisa antes de executar downloads não assinados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подписи Authenticode. Windows SmartScreen предупреждает перед запуском неподписанных загруженных файлов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte Authenticode-signerad. Windows SmartScreen varnar innan osignerade hämtningar körs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode ile imzalanmamış. Windows SmartScreen, imzasız indirmeleri çalıştırmadan önce uyarır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає підпису Authenticode. Windows SmartScreen попереджає перед запуском непідписаних завантажених файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未进行Authenticode签名。运行未签名的下载文件前，Windows SmartScreen会发出警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未經Authenticode簽署。Windows SmartScreen會在執行未簽署的下載項目前發出警告。"
          }
        }
      }
    },
