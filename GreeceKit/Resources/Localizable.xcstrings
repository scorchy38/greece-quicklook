        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法計算檔案結構的雜湊值。"
          }
        }
      }
    },
    "The hash that identifies exactly this code (%@)." : {
      "comment" : "Tooltip. The argument is a hash algorithm, such as “SHA-256”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
