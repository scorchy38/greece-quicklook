    "Signed by %@, a certificate this Mac trusts." : {
      "comment" : "Badge tooltip. The argument is the certificate’s name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiert von %@, einem Zertifikat, dem dieser Mac vertraut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογράφηκε από %@, ένα πιστοποιητικό που θεωρείται αξιόπιστο σε αυτό το Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmado por %@, un certificado de confianza para este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé par %@, un certificat approuvé par ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmato da %@, un certificato considerato attendibile da questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で署名されています。この証明書はこのMacで信頼されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 신뢰하는 인증서인 %@(으)로 서명되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertekend door %@, een certificaat dat deze Mac vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisano certyfikatem %@, któremu ten Mac ufa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinado por %@, um certificado em que este Mac confia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписано сертификатом «%@», которому доверяет этот Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signerad av %@, ett certifikat som den här datorn litar på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’in güvendiği bir sertifika olan %@ ile imzalanmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписано сертифікатом «%@», якому довіряє цей Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由%@签名，这台Mac信任该证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由「%@」簽署，這是此Mac信任的憑證。"
          }
        }
      }
    },
    "Signed by %@, but this Mac doesn’t trust that certificate, so System Settings will call it unverified." : {
      "comment" : "Badge tooltip. The argument is the certificate’s name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiert von %@, aber dieser Mac vertraut dem Zertifikat nicht. Die Systemeinstellungen bezeichnen es daher als nicht überprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογράφηκε από %@, αλλά αυτό το Mac δεν θεωρεί αξιόπιστο το πιστοποιητικό, οπότε οι Ρυθμίσεις συστήματος θα το εμφανίσουν ως μη επαληθευμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmado por %@, pero este Mac no confía en ese certificado, así que Ajustes del Sistema lo mostrará como no verificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé par %@, mais ce Mac n’approuve pas ce certificat : Réglages Système l’indiquera comme non vérifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmato da %@, ma questo Mac non considera attendibile il certificato, quindi Impostazioni di Sistema lo indicherà come non verificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で署名されていますが、このMacはその証明書を信頼していないため、システム設定では未検証と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 서명되었지만 이 Mac에서 해당 인증서를 신뢰하지 않으므로 시스템 설정에 확인되지 않음으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertekend door %@, maar deze Mac vertrouwt dat certificaat niet, dus Systeeminstellingen noemt het niet-geverifieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisano certyfikatem %@, ale ten Mac mu nie ufa, więc Ustawienia systemowe oznaczą profil jako niezweryfikowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinado por %@, mas este Mac não confia nesse certificado, então os Ajustes do Sistema o mostrarão como não verificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписано сертификатом «%@», но этот Mac ему не доверяет, поэтому Системные настройки назовут профиль непроверенным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signerad av %@, men den här datorn litar inte på certifikatet, så Systeminställningar kommer att kalla den overifierad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile imzalanmış ama bu Mac o sertifikaya güvenmediği için Sistem Ayarları profili doğrulanmamış olarak gösterecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписано сертифікатом «%@», але цей Mac йому не довіряє, тому в Системних параметрах профіль буде позначено як неперевірений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由%@签名，但这台Mac不信任该证书，因此“系统设置”会将其标为未验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由「%@」簽署，但此Mac不信任該憑證，因此「系統設定」會將其標示為未驗證。"
          }
        }
      }
    },
    "Signed by Apple as part of its own software." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Apple als Teil der eigenen Software signiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογράφηκε από την Apple ως μέρος του δικού της λογισμικού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmado por Apple como parte de su propio software."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé par Apple en tant que logiciel Apple."
          }
        },
        "it" : {
