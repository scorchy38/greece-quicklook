    "Not code signed. An iPhone or iPad won’t install it until it’s signed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht codesigniert. iPhone und iPad installieren es erst, wenn es signiert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς υπογραφή κώδικα. Ένα iPhone ή iPad δεν θα το εγκαταστήσει μέχρι να υπογραφεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firma de código. Un iPhone o iPad no lo instalará hasta que esté firmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code non signé. Un iPhone ou un iPad ne l’installera pas tant qu’il ne sera pas signé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza firma del codice. iPhone e iPad non lo installeranno finché non sarà firmato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード署名されていません。署名されるまで、iPhoneやiPadにはインストールできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드 서명되지 않았습니다. iPhone 또는 iPad에서는 서명되기 전까지 설치되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen codehandtekening. Een iPhone of iPad installeert het pas als het is ondertekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu kodu. iPhone ani iPad nie zainstaluje go, dopóki nie zostanie podpisany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura de código. Um iPhone ou iPad só o instalará depois que ele for assinado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подписи кода. iPhone или iPad не установит его без подписи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte kodsignerad. En iPhone eller iPad installerar den inte förrän den är signerad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod imzası yok. iPhone veya iPad, imzalanana kadar bunu yüklemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код не підписано. iPhone чи iPad не інсталює його без підпису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未进行代码签名。签名之前，iPhone或iPad不会安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未經代碼簽署。簽署前，iPhone或iPad不會安裝。"
          }
        }
      }
    },
    "Not code signed. macOS won’t open it unless you make an exception, and nothing vouches for who made it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht codesigniert. macOS öffnet es nur mit einer Ausnahme, und nichts bestätigt, wer es erstellt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς υπογραφή κώδικα. Το macOS δεν θα το ανοίξει εκτός αν κάνετε εξαίρεση, και τίποτα δεν εγγυάται ποιος το δημιούργησε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firma de código. macOS no lo abrirá a menos que hagas una excepción, y nada garantiza quién lo ha creado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code non signé. macOS ne l’ouvrira pas sans exception de votre part, et rien ne garantit l’identité de son auteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza firma del codice. macOS non lo aprirà se non crei un’eccezione, e nulla garantisce chi l’abbia creato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード署名されていません。例外を設定しない限りmacOSでは開けず、作成者を保証するものもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드 서명되지 않았습니다. 예외를 만들지 않으면 macOS에서 열리지 않으며, 누가 만들었는지 보증하는 항목도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen codehandtekening. macOS opent het alleen als je een uitzondering maakt, en niets staat in voor wie het heeft gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu kodu. System macOS nie otworzy go bez wyjątku, a nic nie potwierdza, kto go utworzył."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura de código. O macOS só o abrirá se você abrir uma exceção, e nada garante quem o criou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подписи кода. macOS не откроет его без исключения, и ничто не подтверждает, кто его создал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte kodsignerad. macOS öppnar den inte om du inte gör ett undantag, och inget intygar vem som har skapat den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod imzası yok. Siz istisna tanımadıkça macOS bunu açmaz ve kimin yaptığına dair hiçbir güvence yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код не підписано. macOS не відкриє його без винятку, і ніщо не підтверджує, хто його створив."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未进行代码签名。除非你将其设为例外，否则macOS不会打开它，并且无法证明其制作者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未經代碼簽署。除非你設為例外，否則macOS不會打開它，且無法證明其製作者。"
          }
        }
      }
    },
    "Not code signed. macOS won’t run it without an explicit exception." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht codesigniert. macOS führt es ohne ausdrückliche Ausnahme nicht aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς υπογραφή κώδικα. Το macOS δεν θα το εκτελέσει χωρίς ρητή εξαίρεση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firma de código. macOS no lo ejecutará sin una excepción explícita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code non signé. macOS ne l’exécutera pas sans exception explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza firma del codice. macOS non lo esegue senza un’eccezione esplicita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード署名されていません。明示的な例外がない限り、macOSでは実行されません。"
