    "Apple scanned this app for malware and stapled a ticket to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat diese App auf Malware geprüft und ein Ticket angeheftet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Apple έλεγξε αυτήν την εφαρμογή για κακόβουλο λογισμικό και ενσωμάτωσε σε αυτήν ένα εισιτήριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha analizado esta app en busca de software malicioso y le ha adjuntado un ticket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a recherché des logiciels malveillants dans cette app et y a agrafé un ticket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ha verificato la presenza di malware in questa app e vi ha allegato un ticket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleがこのアプリのマルウェアスキャンを行い、チケットをステープルしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 이 앱의 악성 코드를 검사하고 티켓을 첨부했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple heeft deze app op malware gescand en er een ticket aan vastgemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sprawdziło tę aplikację pod kątem złośliwego oprogramowania i dołączyło do niej bilet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple verificou este app em busca de malware e anexou um tíquete a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple проверила это приложение на наличие вредоносного ПО и прикрепила к нему тикет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple har sökt igenom appen efter skadlig programvara och bifogat ett bevis."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple bu uygulamayı kötü amaçlı yazılımlara karşı taradı ve uygulamaya bir bilet iliştirdi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple перевірила цю програму на наявність зловмисного ПЗ і прикріпила до неї квитанцію."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple已扫描此App是否含有恶意软件，并为其装订了票据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple已掃描此App是否含有惡意軟體，並附加了票證。"
          }
        }
      }
    },
