          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu kodu. System macOS nie uruchomi go bez wyraźnego wyjątku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
