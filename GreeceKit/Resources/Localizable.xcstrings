    "Installer asks for an administrator password and writes files as root." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Installationsprogramm fragt nach einem Administratorpasswort und schreibt Dateien als root."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Πρόγραμμα εγκατάστασης ζητά συνθηματικό διαχειριστή και γράφει αρχεία ως root."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Instalador solicita una contraseña de administrador y escribe archivos como root."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’installation demande un mot de passe d’administrateur et écrit les fichiers en tant que root."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer chiede una password di amministratore e scrive i file come root."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストーラは管理者パスワードを要求し、rootとしてファイルを書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 프로그램이 관리자 암호를 요청하고 root 권한으로 파일을 씁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installatieprogramma vraagt om een beheerderswachtwoord en schrijft bestanden als root."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalator prosi o hasło administratora i zapisuje pliki jako root."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Instalador pede uma senha de administrador e grava os arquivos como root."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установщик запрашивает пароль администратора и записывает файлы от имени root."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeraren ber om ett administratörslösenord och skriver filer som root."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleyici bir yönetici parolası ister ve dosyaları root olarak yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсталятор запитує пароль адміністратора й записує файли від імені root."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“安装器”会要求输入管理员密码，并以root身份写入文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「安裝程式」會要求輸入管理者密碼，並以root身分寫入檔案。"
          }
        }
      }
    },
    "Installer asks you to quit these apps before installing." : {
