    "On a Mac with Apple silicon, Installer needs Rosetta to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Mac mit Apple Chip benötigt das Installationsprogramm Rosetta, um es zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε Mac με Apple silicon, το Πρόγραμμα εγκατάστασης χρειάζεται το Rosetta για να το ανοίξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un Mac con Apple silicon, el Instalador necesita Rosetta para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un Mac avec Apple silicon, le programme d’installation a besoin de Rosetta pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sui Mac con Apple silicon, Installer richiede Rosetta per aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleシリコン搭載のMacでは、インストーラで開くにはRosettaが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon이 탑재된 Mac에서는 설치 프로그램이 이 패키지를 열려면 Rosetta가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een Mac met Apple silicon heeft Installatieprogramma Rosetta nodig om het te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Macu z Apple silicon Instalator potrzebuje Rosetty, aby go otworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um Mac com Apple silicon, o Instalador precisa do Rosetta para abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac с Apple silicon Установщику нужна Rosetta, чтобы открыть его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På en Mac med Apple silicon behöver Installeraren Rosetta för att öppna det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple silicon’lı bir Mac’te Yükleyici’nin bunu açması için Rosetta gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac з Apple silicon Інсталятору потрібна Rosetta, щоб відкрити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搭载Apple芯片的Mac上，“安装器”需要Rosetta才能打开它。"
          }
