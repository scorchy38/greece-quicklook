    "Opts into macOS’s Enhanced Security protections, such as a hardened memory allocator." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt die Schutzfunktionen der erweiterten Sicherheit von macOS, etwa einen gehärteten Speicher-Allocator."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί τις προστασίες Ενισχυμένης ασφάλειας του macOS, όπως έναν ενισχυμένο εκχωρητή μνήμης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las protecciones de Seguridad mejorada de macOS, como un asignador de memoria reforzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les protections Sécurité renforcée de macOS, comme un allocateur de mémoire renforcé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adotta le protezioni di Sicurezza avanzata di macOS, come un allocatore di memoria rafforzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強化されたメモリアロケータなど、macOSの拡張セキュリティ保護を有効にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강화된 메모리 할당자와 같은 macOS의 향상된 보안 보호 기능을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de beveiligingen van Verbeterde beveiliging in macOS, zoals een geharde geheugentoewijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzysta z zabezpieczeń Enhanced Security systemu macOS, np. ze wzmocnionego alokatora pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adota as proteções de Segurança Aprimorada do macOS, como um alocador de memória reforçado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует защиту «Расширенная безопасность» macOS, например усиленный распределитель памяти."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder skydden i Förbättrad säkerhet i macOS, till exempel en härdad minnesallokerare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlendirilmiş bellek ayırıcı gibi macOS Gelişmiş Güvenlik korumalarını kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
