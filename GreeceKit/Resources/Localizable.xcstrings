          }
        }
      }
    },
    "Protections from the compiler and the Windows loader that make memory-corruption bugs harder to exploit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schutzmechanismen von Compiler und Windows-Loader, die das Ausnutzen von Speicherfehlern erschweren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστασίες του μεταγλωττιστή και του φορτωτή των Windows που δυσκολεύουν την εκμετάλλευση σφαλμάτων αλλοίωσης μνήμης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protecciones del compilador y del cargador de Windows que dificultan aprovechar los errores de corrupción de memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protections du compilateur et du chargeur Windows qui rendent les bugs de corruption de mémoire plus difficiles à exploiter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protezioni del compilatore e del caricatore di Windows che rendono più difficile sfruttare i bug di corruzione della memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ破損バグを悪用しにくくする、コンパイラとWindowsローダによる保護機能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리 손상 버그를 악용하기 어렵게 만드는 컴파일러 및 Windows 로더의 보호 기능입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveiligingen van de compiler en de Windows-loader die geheugenfouten moeilijker te misbruiken maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabezpieczenia kompilatora i modułu ładującego Windows, które utrudniają wykorzystanie błędów uszkodzenia pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteções do compilador e do carregador do Windows que dificultam a exploração de bugs de corrupção de memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитные механизмы компилятора и загрузчика Windows, затрудняющие использование ошибок повреждения памяти."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skydd från kompilatorn och Windows-laddaren som gör minnesfel svårare att utnyttja."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derleyicinin ve Windows yükleyicisinin, bellek bozulması hatalarından yararlanmayı zorlaştıran korumaları."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист від компілятора й завантажувача Windows, що ускладнює використання помилок пошкодження памʼяті."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由编译器和Windows加载器提供的保护措施，可使内存损坏漏洞更难被利用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自編譯器和Windows載入器的保護，讓記憶體損毀錯誤更難被利用。"
          }
        }
      }
    },
    "Protects against code injection, library hijacking and memory tampering." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt vor Code-Injektion, Library-Hijacking und Speichermanipulation."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστατεύει από έγχυση κώδικα, υποκλοπή βιβλιοθηκών και αλλοίωση μνήμης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege contra la inyección de código, el secuestro de bibliotecas y la manipulación de la memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protège contre l’injection de code, le détournement de bibliothèques et la falsification de la mémoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protegge da iniezione di codice, dirottamento delle librerie e manomissione della memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードインジェクション、ライブラリハイジャック、メモリ改ざんから保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드 삽입, 라이브러리 하이재킹 및 메모리 변조로부터 보호합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschermt tegen code-injectie, het kapen van bibliotheken en geheugenmanipulatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroni przed wstrzykiwaniem kodu, przejmowaniem bibliotek i manipulowaniem pamięcią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege contra injeção de código, sequestro de bibliotecas e adulteração de memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защищает от внедрения кода, подмены библиотек и вмешательства в память."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyddar mot kodinjicering, kapning av bibliotek och manipulering av minnet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod enjeksiyonuna, kitaplık ele geçirmeye ve bellek kurcalamaya karşı korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захищає від впровадження коду, підміни бібліотек і втручання в памʼять."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防范代码注入、库劫持和内存篡改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防範程式碼注入、函式庫劫持和記憶體竄改。"
          }
        }
      }
    },
