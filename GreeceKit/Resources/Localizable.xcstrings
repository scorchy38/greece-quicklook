    "Google Play re-signs the APKs it builds from this bundle with the app signing key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play signiert die aus diesem Bundle erstellten APKs neu mit dem App-Signaturschlüssel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Google Play υπογράφει ξανά τα APK που δημιουργεί από αυτήν τη δέσμη με το κλειδί υπογραφής εφαρμογής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play vuelve a firmar con la clave de firma de apps los APK que genera a partir de este paquete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play signe à nouveau les APK qu’il génère à partir de ce paquet avec la clé de signature d’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play firma di nuovo gli APK generati da questo bundle con la chiave di firma dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Playは、このバンドルからビルドしたAPKをアプリ署名鍵で再署名します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play는 이 번들에서 빌드한 APK에 앱 서명 키로 다시 서명합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play ondertekent de APK's die het uit deze bundel maakt opnieuw met de app-ondertekeningssleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play ponownie podpisuje kluczem podpisywania aplikacji pliki APK zbudowane z tego pakietu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play assina novamente com a chave de assinatura do app os APKs que gera a partir deste pacote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play повторно подписывает APK, собранные из этого пакета, ключом подписи приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play signerar om de APK-filer som byggs från det här paketet med appens signeringsnyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play, bu paketten oluşturduğu APK’ları uygulama imzalama anahtarıyla yeniden imzalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play повторно підписує APK, створені з цього пакета, ключем підпису програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play会使用App签名密钥，重新签名它从此捆绑包构建的APK。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play會以App簽署金鑰，重新簽署從此套件建構的APK。"
          }
        }
      }
    },
