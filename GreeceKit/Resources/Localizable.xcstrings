    "Windows asks for administrator permission every time it starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows fragt bei jedem Start nach Administratorberechtigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Windows ζητούν άδεια διαχειριστή κάθε φορά που ξεκινά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows solicita permiso de administrador cada vez que se inicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows demande l’autorisation d’un administrateur à chaque démarrage du programme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows chiede l’autorizzazione dell’amministratore a ogni avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動するたびに、Windowsが管理者の許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작할 때마다 Windows에서 관리자 권한을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows vraagt bij elke start om beheerderstoestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows prosi o zgodę administratora przy każdym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Windows pede permissão de administrador sempre que ele é iniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows запрашивает разрешение администратора при каждом запуске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows ber om administratörsbehörighet varje gång programmet startar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows, her başlatıldığında yönetici izni ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows запитує дозвіл адміністратора під час кожного запуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次启动时，Windows都会请求管理员权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次啟動時，Windows都會要求管理者權限。"
          }
        }
      }
    },
