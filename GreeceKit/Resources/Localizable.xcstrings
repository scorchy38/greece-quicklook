    "Peers come only from its trackers: no DHT or peer exchange." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peers stammen nur von den Trackern: kein DHT und kein Peer-Austausch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ομότιμοι προέρχονται μόνο από τους ιχνηλάτες του: χωρίς DHT ή ανταλλαγή ομοτίμων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pares solo proceden de sus trackers: sin DHT ni intercambio de pares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pairs proviennent uniquement de ses trackers : ni DHT ni échange de pairs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I peer provengono solo dai tracker: niente DHT né scambio di peer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピアはトラッカーからのみ取得されます。DHTやピア交換は使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피어는 트래커에서만 가져옵니다. DHT 또는 피어 교환은 사용하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peers komen alleen van de trackers: geen DHT of peer exchange."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peery pochodzą tylko z jego trackerów: bez DHT ani wymiany peerów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os peers vêm apenas dos trackers: sem DHT nem troca de peers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пиры поступают только от трекеров: без DHT и обмена пирами."
