    "Grows as files are added, up to the size of its disk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wächst mit hinzugefügten Dateien bis zur Größe des Laufwerks."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγαλώνει καθώς προστίθενται αρχεία, έως το μέγεθος του δίσκου του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece a medida que se añaden archivos, hasta el tamaño de su disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’agrandit à mesure que des fichiers sont ajoutés, jusqu’à la taille de son disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce man mano che si aggiungono file, fino alle dimensioni del disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを追加すると、ディスクのサイズまで拡大します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 추가될 때마다 디스크 크기까지 커집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groeit naarmate er bestanden worden toegevoegd, tot de grootte van de schijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie wraz z dodawaniem plików, aż do wielkości dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce conforme arquivos são adicionados, até o tamanho do disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличивается по мере добавления файлов, вплоть до размера диска."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växer när filer läggs till, upp till skivans storlek."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya eklendikçe diskinin büyüklüğüne kadar büyür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збільшується в міру додавання файлів, до розміру свого диска."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着文件的添加而增大，最大可达其磁盘大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會隨著加入檔案而增大，最多可達其磁碟大小。"
          }
        }
      }
    },
