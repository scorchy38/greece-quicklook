        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypterad med %@. Filerna kan bara läsas med lösenordet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile şifrelenmiş. Dosyaları yalnızca parolayla okunabilir."
