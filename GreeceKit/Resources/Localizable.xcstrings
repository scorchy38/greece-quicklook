    "Android asks before granting permissions marked “Asks first”." : {
      "comment" : "Section footer. “Asks first” is a label on the rows above: use the same words",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Berechtigungen mit „Fragt zuerst“ fragt Android vor dem Erteilen nach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Android ρωτά πριν παραχωρήσει τις άδειες με την ένδειξη «Ζητά άδεια»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pregunta antes de conceder los permisos marcados con «Pregunta antes»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android demande votre accord avant d’accorder les autorisations marquées « Sur demande »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android chiede il consenso prima di concedere le autorizzazioni contrassegnate con «Richiede consenso»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「事前に確認」の権限は、許可する前にAndroidが確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘사용자 확인’으로 표시된 권한은 Android가 허용하기 전에 사용자에게 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android vraagt het eerst voordat rechten met ‘Vraagt eerst’ worden verleend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pyta przed przyznaniem uprawnień oznaczonych jako „Pyta o zgodę”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Android pergunta antes de conceder as permissões marcadas como “Pergunta antes”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android спрашивает пользователя, прежде чем предоставить разрешения с пометкой «С запросом»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android frågar innan behörigheter markerade ”Frågar först” beviljas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android, “Önce sorar” olarak işaretlenen izinleri vermeden önce sorar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android запитує, перш ніж надати дозволи з позначкою «Запитує дозвіл»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于标有“先询问”的权限，Android会在授予前询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android會先詢問，才授予標示為「需先詢問」的權限。"
          }
        }
      }
    },
    "Android asks before granting permissions marked “Asks first”. Special access is turned on in Settings." : {
      "comment" : "Section footer. “Asks first” and “Special access” are labels on the rows above: use the same words",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Berechtigungen mit „Fragt zuerst“ fragt Android vor dem Erteilen nach. Speziellen Zugriff aktivierst du in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Android ρωτά πριν παραχωρήσει τις άδειες με την ένδειξη «Ζητά άδεια». Η ειδική πρόσβαση ενεργοποιείται στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pregunta antes de conceder los permisos marcados con «Pregunta antes». El acceso especial se activa en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android demande votre accord avant d’accorder les autorisations marquées « Sur demande ». L’accès spécial s’active dans les Paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android chiede il consenso prima di concedere le autorizzazioni contrassegnate con «Richiede consenso». L’accesso speciale si attiva in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「事前に確認」の権限は、許可する前にAndroidが確認します。特別なアクセスは“設定”でオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘사용자 확인’으로 표시된 권한은 Android가 허용하기 전에 사용자에게 묻습니다. 특별 액세스는 설정에서 켭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android vraagt het eerst voordat rechten met ‘Vraagt eerst’ worden verleend. Speciale toegang wordt ingeschakeld in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pyta przed przyznaniem uprawnień oznaczonych jako „Pyta o zgodę”. Dostęp specjalny włącza się w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Android pergunta antes de conceder as permissões marcadas como “Pergunta antes”. O acesso especial é ativado nas Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android спрашивает пользователя, прежде чем предоставить разрешения с пометкой «С запросом». Специальный доступ включается в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android frågar innan behörigheter markerade ”Frågar först” beviljas. Särskild åtkomst slås på i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android, “Önce sorar” olarak işaretlenen izinleri vermeden önce sorar. Özel erişim, Ayarlar’dan açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android запитує, перш ніж надати дозволи з позначкою «Запитує дозвіл». Спеціальний доступ вмикається в Налаштуваннях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于标有“先询问”的权限，Android会在授予前询问。特殊权限需在“设置”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android會先詢問，才授予標示為「需先詢問」的權限。特殊存取權需在「設定」中開啟。"
          }
        }
      }
    },
