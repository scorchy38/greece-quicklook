    "Native code only for x86. Most Android phones use ARM processors and can’t run it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativer Code nur für x86. Die meisten Android-Smartphones haben ARM-Prozessoren und können ihn nicht ausführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγγενής κώδικας μόνο για x86. Τα περισσότερα τηλέφωνα Android χρησιμοποιούν επεξεργαστές ARM και δεν μπορούν να τον εκτελέσουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código nativo solo para x86. La mayoría de los teléfonos Android usan procesadores ARM y no pueden ejecutarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code natif pour x86 uniquement. La plupart des téléphones Android utilisent des processeurs ARM et ne peuvent pas l’exécuter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codice nativo solo per x86. La maggior parte dei telefoni Android usa processori ARM e non può eseguirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x86用のネイティブコードのみです。ほとんどのAndroidスマートフォンはARMプロセッサを使用しているため、実行できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x86 전용 네이티브 코드입니다. 대부분의 Android 휴대폰은 ARM 프로세서를 사용하므로 실행할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native code alleen voor x86. De meeste Android-telefoons hebben ARM-processors en kunnen deze code niet uitvoeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod natywny tylko dla x86. Większość telefonów z Androidem ma procesory ARM i nie może go uruchomić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código nativo apenas para x86. A maioria dos celulares Android usa processadores ARM e não consegue executá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нативный код только для x86. Большинство телефонов Android работают на процессорах ARM и не смогут его запустить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativ kod endast för x86. De flesta Android-telefoner har ARM-processorer och kan inte köra den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca x86 için yerel kod. Çoğu Android telefon ARM işlemci kullandığından bunu çalıştıramaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нативний код лише для x86. Більшість телефонів Android мають процесори ARM і не можуть його запустити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅含x86原生代码。大多数Android手机使用ARM处理器，无法运行它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅有x86的原生程式碼。大多數Android手機使用ARM處理器，無法執行。"
          }
        }
      }
    },
