    "Entitlements granted by its signature. Hover over an item for its key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Signatur gewährte Berechtigungen. Halte den Zeiger über ein Objekt, um seinen Schlüssel zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δικαιώματα που παραχωρεί η υπογραφή της. Τοποθετήστε τον δείκτη σε ένα στοιχείο για να δείτε το κλειδί του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derechos concedidos por su firma. Sitúa el puntero sobre un ítem para ver su clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Droits accordés par sa signature. Survolez un élément pour afficher sa clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entitlement concessi dalla firma. Passa il puntatore su un elemento per vederne la chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名によって付与されたエンタイトルメントです。項目にポインタを合わせるとキーが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명으로 부여된 인타이틀먼트입니다. 항목 위에 포인터를 올리면 키가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechten die via de handtekening zijn verleend. Houd de aanwijzer boven een onderdeel voor de sleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienia nadane przez jej podpis. Umieść wskaźnik nad pozycją, aby zobaczyć klucz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direitos concedidos pela assinatura. Posicione o ponteiro sobre um item para ver a chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Права, предоставленные подписью. Наведите указатель на пункт, чтобы увидеть ключ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rättigheter som beviljas av signaturen. Håll pekaren över ett objekt för att se dess nyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzasının verdiği yetkiler. Anahtarını görmek için imleci bir öğenin üzerinde tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Права, надані підписом. Наведіть вказівник на елемент, щоб побачити його ключ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其签名授予的授权。将指针悬停在项目上可查看其键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其簽名所授予的授權。將指標停在項目上可查看其鍵。"
          }
        }
      }
    },
