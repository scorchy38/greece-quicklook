    "Not signed. Installer will say it comes from an unidentified developer." : {
      "comment" : "Badge tooltip. Installer is the macOS app that installs packages",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht signiert. Das Installationsprogramm meldet, dass es von einem nicht verifizierten Entwickler stammt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι υπογεγραμμένο. Το Πρόγραμμα εγκατάστασης θα αναφέρει ότι προέρχεται από μη αναγνωρισμένο δημιουργό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firmar. El Instalador indicará que procede de un desarrollador no identificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non signé. Le programme d’installation indiquera qu’il provient d’un développeur non identifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non firmato. Installer indicherà che proviene da un’azienda di sviluppo non identificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名されていません。インストーラでは開発元が未確認と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명되지 않았습니다. 설치 프로그램에서 확인되지 않은 개발자가 배포한 항목이라고 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet ondertekend. Installatieprogramma meldt dat het afkomstig is van een onbekende ontwikkelaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu. Instalator poinformuje, że pakiet pochodzi od niezidentyfikowanego dewelopera."
