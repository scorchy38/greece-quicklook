    "The package changed after it was signed, or its signature is damaged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket wurde nach dem Signieren geändert oder die Signatur ist beschädigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πακέτο άλλαξε μετά την υπογραφή του ή η υπογραφή του είναι κατεστραμμένη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete ha cambiado después de firmarse o su firma está dañada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet a été modifié après sa signature, ou sa signature est endommagée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto è stato modificato dopo la firma oppure la firma è danneggiata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名後にパッケージが変更されたか、署名が破損しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 후 패키지가 변경되었거나 서명이 손상되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het pakket is na ondertekening gewijzigd, of de handtekening is beschadigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiet zmienił się po podpisaniu albo jego podpis jest uszkodzony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pacote foi alterado depois de assinado, ou a assinatura está danificada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет изменился после подписания, или его подпись повреждена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketet har ändrats efter att det signerades, eller så är signaturen skadad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket imzalandıktan sonra değişmiş veya imzası hasarlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет змінено після підписання, або його підпис пошкоджено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "软件包在签名后已更改，或其签名已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件在簽署後已被更改，或其簽名已損毀。"
          }
        }
      }
    },
    "The package is relocatable: if you moved a previous version, Installer updates it there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket ist verschiebbar: Wenn du eine frühere Version bewegt hast, aktualisiert das Installationsprogramm sie dort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πακέτο είναι μετακινήσιμο: αν μετακινήσατε μια προηγούμενη έκδοση, το Πρόγραμμα εγκατάστασης την ενημερώνει εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete es reubicable: si has movido una versión anterior, el Instalador la actualiza en esa ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet est déplaçable : si vous avez déplacé une version précédente, le programme d’installation la met à jour à son emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto è riposizionabile: se hai spostato una versione precedente, Installer la aggiorna lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパッケージは再配置可能です。以前のバージョンを移動した場合は、インストーラがその場所でアップデートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재배치 가능한 패키지입니다. 이전 버전을 이동했다면 설치 프로그램이 해당 위치에서 업데이트합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het pakket is verplaatsbaar: als je een vorige versie hebt verplaatst, werkt Installatieprogramma die daar bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiet jest przenośny: jeśli przeniesiono poprzednią wersję, Instalator uaktualni ją w nowym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pacote é realocável: se você moveu uma versão anterior, o Instalador a atualiza onde ela estiver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет перемещаемый: если Вы переместили предыдущую версию, Установщик обновит ее там."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketet är flyttbart: om du har flyttat en tidigare version uppdaterar Installeraren den där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketin yeri değiştirilebilir: önceki sürümü taşıdıysanız Yükleyici onu taşıdığınız yerde günceller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет переміщуваний: якщо ви перемістили попередню версію, Інсталятор оновить її там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此软件包可重新定位：如果你移动过旧版本，“安装器”会在其所在位置进行更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此套件可重新定位：若你移動過先前的版本，「安裝程式」會在該位置更新。"
          }
        }
      }
    },
