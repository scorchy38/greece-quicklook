          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У администраторов запрашивается разрешение; остальные пользователи запускают обычным образом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
