    "Gatekeeper can still find a ticket online when the package opens. Greece only reads what’s in the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper kann beim Öffnen des Pakets trotzdem online ein Ticket finden. Greece liest nur, was in der Datei steht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Gatekeeper μπορεί ακόμη να βρει εισιτήριο στο Διαδίκτυο όταν ανοίγει το πακέτο. Το Greece διαβάζει μόνο ό,τι υπάρχει στο αρχείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper aún puede encontrar un ticket en línea al abrir el paquete. Greece solo lee lo que hay en el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper peut toujours trouver un ticket en ligne à l’ouverture du paquet. Greece ne lit que le contenu du fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper può comunque trovare un ticket online all’apertura del pacchetto. Greece legge solo il contenuto del file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージを開くときに、Gatekeeperがオンラインでチケットを見つける場合があります。Greeceはファイル内の情報のみを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지를 열 때 Gatekeeper가 온라인에서 티켓을 찾을 수도 있습니다. Greece는 파일에 있는 내용만 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper kan bij het openen van het pakket nog online een ticket vinden. Greece leest alleen wat in het bestand staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper może nadal znaleźć bilet online po otwarciu pakietu. Greece odczytuje tylko zawartość pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Gatekeeper ainda pode encontrar um tíquete on-line quando o pacote é aberto. O Greece só lê o que está no arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper может найти тикет онлайн при открытии пакета. Greece читает только содержимое файла."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper kan fortfarande hitta ett bevis online när paketet öppnas. Greece läser bara det som finns i filen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper, paket açıldığında bileti çevrimiçi olarak yine de bulabilir. Greece yalnızca dosyanın içindekini okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper може знайти квитанцію онлайн під час відкриття пакета. Greece читає лише вміст файлу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开软件包时，Gatekeeper仍可在线查找票据。Greece只读取文件中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套件打開時，Gatekeeper仍可在線上找到票證。Greece只會讀取檔案中的內容。"
          }
        }
      }
    },
    "Generated" : {
      "comment" : "Column constraint: computed from other columns",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiert"
          }
