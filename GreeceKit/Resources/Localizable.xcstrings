    "Not signed. Android refuses to install unsigned packages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht signiert. Android installiert keine unsignierten Pakete."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι υπογεγραμμένο. Το Android δεν εγκαθιστά μη υπογεγραμμένα πακέτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firmar. Android no instala paquetes sin firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non signé. Android refuse d’installer les paquets non signés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non firmato. Android non installa i pacchetti non firmati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名されていません。Androidは未署名のパッケージをインストールしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명되지 않았습니다. Android는 서명되지 않은 패키지를 설치하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet ondertekend. Android installeert geen niet-ondertekende pakketten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu. Android nie instaluje niepodpisanych pakietów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não assinado. O Android se recusa a instalar pacotes não assinados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
