          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Sandbox’ın erişmesine izin verdikleri. Yetkisini görmek için imleci bir öğenin üzerinde tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До чого App Sandbox надає доступ. Наведіть вказівник на елемент, щоб побачити відповідне право."
