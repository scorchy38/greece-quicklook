    "An installer built with %@. It unpacks and runs more code than this file shows." : {
      "comment" : "Badge tooltip. The argument names an installer toolkit, such as “NSIS”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein mit %@ erstelltes Installationsprogramm. Es entpackt und führt mehr Code aus, als diese Datei zeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόγραμμα εγκατάστασης που δημιουργήθηκε με %@. Αποσυμπιέζει και εκτελεί περισσότερο κώδικα από όσο δείχνει αυτό το αρχείο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un instalador creado con %@. Extrae y ejecuta más código del que muestra este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme d’installation créé avec %@. Il décompresse et exécute davantage de code que ce fichier n’en montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma di installazione creato con %@. Estrae ed esegue altro codice oltre a quello visibile in questo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で作成されたインストーラです。このファイルに表示されている以上のコードを展開して実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 빌드한 설치 프로그램입니다. 이 파일에 표시된 것보다 많은 코드를 풀어서 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een installatieprogramma gemaakt met %@. Het pakt meer code uit en voert die uit dan dit bestand toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalator zbudowany przy użyciu %@. Rozpakowuje i uruchamia więcej kodu, niż pokazuje ten plik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um instalador criado com %@. Ele extrai e executa mais código do que este arquivo mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установщик, созданный с помощью %@. Он распаковывает и запускает больше кода, чем видно в этом файле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En installerare byggd med %@. Den packar upp och kör mer kod än den här filen visar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile oluşturulmuş bir yükleyici. Bu dosyanın gösterdiğinden daha fazla kod açar ve çalıştırır."
