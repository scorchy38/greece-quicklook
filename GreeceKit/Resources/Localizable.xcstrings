    "Signed without a certificate. Gatekeeper treats it as coming from an unidentified developer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Zertifikat signiert. Gatekeeper behandelt es, als stamme es von einem nicht verifizierten Entwickler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
