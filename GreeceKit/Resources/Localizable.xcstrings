    "An ad hoc signature proves the code is intact, not who made it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ad-hoc-Signatur belegt, dass der Code intakt ist, nicht aber, wer ihn erstellt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια υπογραφή ad hoc αποδεικνύει ότι ο κώδικας είναι ακέραιος, όχι ποιος τον δημιούργησε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una firma ad hoc demuestra que el código está intacto, no quién lo ha creado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une signature ad hoc prouve que le code est intact, pas qui l’a créé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una firma ad hoc prova che il codice è integro, non chi l’ha creato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドホック署名は、コードが改変されていないことは証明しますが、作成者は証明しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애드혹 서명은 코드가 손상되지 않았음을 증명하지만, 누가 만들었는지는 증명하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ad-hochandtekening bewijst dat de code intact is, niet wie hem heeft gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis ad hoc potwierdza, że kod jest nienaruszony, ale nie to, kto go utworzył."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma assinatura ad hoc comprova que o código está intacto, não quem o criou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись ad hoc подтверждает целостность кода, но не его автора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ad hoc-signatur bevisar att koden är intakt, inte vem som har skapat den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad hoc imza, kodu kimin yaptığını değil, kodun bozulmadığını kanıtlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпис ad hoc підтверджує цілісність коду, але не те, хто його створив."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad Hoc签名只能证明代码完好，而不能证明其制作者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ad hoc簽名只能證明程式碼完好，無法證明製作者。"
          }
        }
      }
    },
