    "These run automatically, without you opening an app. You can turn them off in Login Items & Extensions." : {
      "comment" : "Section footer. “Login Items & Extensions” is a pane in System Settings",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese laufen automatisch, ohne dass du eine App öffnest. Du kannst sie unter „Anmeldeobjekte & Erweiterungen“ deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελούνται αυτόματα, χωρίς να ανοίξετε κάποια εφαρμογή. Μπορείτε να τα απενεργοποιήσετε στα «Στοιχεία εισόδου και επεκτάσεις»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecutan automáticamente, sin que abras ninguna app. Puedes desactivarlos en Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils s’exécutent automatiquement, sans que vous ouvriez d’app. Vous pouvez les désactiver dans Ouverture et extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono eseguiti automaticamente, senza che tu apra un’app. Puoi disattivarli in Elementi login ed estensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはアプリを開かなくても自動的に実行されます。“ログイン項目と機能拡張”でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않아도 자동으로 실행됩니다. 로그인 항목 및 확장 프로그램에서 끌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze worden automatisch uitgevoerd, zonder dat je een app opent. Je kunt ze uitschakelen in ‘Inlogonderdelen en extensies’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działają automatycznie, bez otwierania aplikacji. Możesz je wyłączyć w panelu Rzeczy i rozszerzenia otwierane podczas logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes itens são executados automaticamente, sem que você abra um app. Você pode desativá-los em Itens de Início de Sessão e Extensões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они запускаются автоматически, без открытия приложения. Их можно выключить в разделе «Объекты входа и расширения»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De körs automatiskt utan att du öppnar någon app. Du kan stänga av dem i Startobjekt och tillägg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar siz bir uygulama açmadan otomatik olarak çalışır. Oturum Açma Öğeleri ve Genişletmeler bölümünden kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони запускаються автоматично, без відкриття програми. Їх можна вимкнути в розділі «Автозапуск і розширення»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些项目会自动运行，无需你打开App。你可以在“登录项与扩展”中将其关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些項目會自動執行，不需你打開App。你可以在「登入項目與延伸功能」中將其關閉。"
          }
        }
      }
    },
    "These swatches are damaged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Farbfelder sind beschädigt."
          }
        },
        "el" : {
