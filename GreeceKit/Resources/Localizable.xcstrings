            "state" : "translated",
            "value" : "Apple 자체 소프트웨어는 공증되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software van Apple zelf wordt niet genotariseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprogramowanie Apple nie jest poświadczane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O software da própria Apple não é autenticado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собственное ПО Apple не нотаризуется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples egen programvara attesteras inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’ın kendi yazılımları onaylama işleminden geçmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власне програмне забезпечення Apple не завіряється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple自有软件不进行公证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple自己的軟體不經公證。"
          }
        }
      }
    },
    "Apple’s ticket is stapled, so Gatekeeper can check it offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ticket von Apple ist angeheftet, daher kann Gatekeeper es offline prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το εισιτήριο της Apple είναι ενσωματωμένο, οπότε το Gatekeeper μπορεί να το ελέγξει εκτός σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ticket de Apple está adjunto, así que Gatekeeper puede comprobarlo sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ticket d’Apple est agrafé : Gatekeeper peut le vérifier hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ticket di Apple è allegato, quindi Gatekeeper può verificarlo offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのチケットがステープルされているため、Gatekeeperはオフラインで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 티켓이 첨부되어 있으므로 Gatekeeper가 오프라인에서 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ticket van Apple is vastgemaakt, dus Gatekeeper kan het offline controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilet Apple jest dołączony, więc Gatekeeper może go sprawdzić offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tíquete da Apple está anexado, então o Gatekeeper pode verificá-lo off-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тикет Apple прикреплен, поэтому Gatekeeper может проверить его офлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples bevis är bifogat, så Gatekeeper kan kontrollera det offline."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’ın bileti iliştirilmiş, bu nedenle Gatekeeper çevrimdışı denetleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Квитанцію Apple прикріплено, тож Gatekeeper може перевірити її офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已装订Apple的票据，因此Gatekeeper可以离线检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已附加Apple的票證，因此Gatekeeper可離線檢查。"
          }
        }
      }
    },
