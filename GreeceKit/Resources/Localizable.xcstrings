        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드 서명되지 않았습니다. 명시적인 예외 없이는 macOS에서 실행되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
