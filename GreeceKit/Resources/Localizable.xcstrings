    "Signed automatically by the linker so it can run on Apple silicon. It doesn’t identify a developer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch vom Linker signiert, damit es auf Macs mit Apple Chip läuft. Die Signatur identifiziert keinen Entwickler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογράφηκε αυτόματα από τον συνδέτη ώστε να εκτελείται σε Apple silicon. Δεν προσδιορίζει δημιουργό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmado automáticamente por el enlazador para que pueda ejecutarse en Apple silicon. No identifica a ningún desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé automatiquement par l’éditeur de liens pour pouvoir s’exécuter sur Apple silicon. N’identifie aucun développeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmato automaticamente dal linker per poter funzionare su Apple silicon. Non identifica un’azienda di sviluppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleシリコンで実行できるようにリンカによって自動的に署名されています。デベロッパを識別するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon에서 실행될 수 있도록 링커가 자동으로 서명했습니다. 개발자를 식별하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch ondertekend door de linker zodat het op Apple silicon kan draaien. Hiermee wordt geen ontwikkelaar geïdentificeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisany automatycznie przez konsolidator, aby mógł działać na Apple silicon. Nie identyfikuje dewelopera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinado automaticamente pelo vinculador para poder funcionar em Apple silicon. Não identifica um desenvolvedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически подписано компоновщиком для запуска на Apple silicon. Разработчика не идентифицирует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signerad automatiskt av länkaren så att den kan köras på Apple silicon. Den identifierar ingen utvecklare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple silicon’da çalışabilmesi için bağlayıcı tarafından otomatik olarak imzalanmış. Bir geliştiriciyi tanımlamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично підписано компонувальником, щоб код працював на Apple silicon. Розробника цей підпис не ідентифікує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由链接器自动签名，以便在Apple芯片上运行。此签名不标识开发者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由連結器自動簽署，以便在Apple晶片上執行。無法識別開發者。"
          }
        }
      }
    },
