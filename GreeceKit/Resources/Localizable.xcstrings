    "Its JavaScript is allowed to run commands on your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das JavaScript darf Befehle auf deinem Mac ausführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το JavaScript του επιτρέπεται να εκτελεί εντολές στο Mac σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su JavaScript puede ejecutar comandos en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son JavaScript est autorisé à exécuter des commandes sur votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo JavaScript può eseguire comandi sul Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このJavaScriptには、Mac上でコマンドを実行することが許可されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 JavaScript는 Mac에서 명령을 실행할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De JavaScript mag opdrachten uitvoeren op je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego kod JavaScript może uruchamiać polecenia na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O JavaScript dele tem permissão para executar comandos no Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его коду JavaScript разрешено выполнять команды на Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess JavaScript får köra kommandon på din Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript’inin Mac’inizde komut çalıştırmasına izin veriliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його JavaScript може виконувати команди на Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其JavaScript可以在你的Mac上运行命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其JavaScript可在你的Mac上執行指令。"
          }
        }
      }
    },
    "Its contents no longer match the signature." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inhalt stimmt nicht mehr mit der Signatur überein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα περιεχόμενά του δεν αντιστοιχούν πλέον στην υπογραφή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su contenido ya no coincide con la firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son contenu ne correspond plus à la signature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenuto non corrisponde più alla firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容が署名と一致しなくなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내용이 더 이상 서명과 일치하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inhoud komt niet meer overeen met de handtekening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego zawartość nie zgadza się już z podpisem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conteúdo não corresponde mais à assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Содержимое больше не соответствует подписи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehållet matchar inte längre signaturen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçeriği artık imzayla eşleşmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його вміст більше не відповідає підпису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其内容与签名不再匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其內容已不符合簽名。"
          }
        }
      }
    },
    "Its resources use an older seal that macOS can’t check, so only the code was verified." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ressourcen verwenden ein älteres Siegel, das macOS nicht prüfen kann, daher wurde nur der Code überprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πόροι του χρησιμοποιούν παλαιότερη σφραγίδα που δεν μπορεί να ελέγξει το macOS, οπότε επαληθεύτηκε μόνο ο κώδικας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus recursos usan un sello antiguo que macOS no puede comprobar, así que solo se ha verificado el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses ressources utilisent un ancien sceau que macOS ne peut pas vérifier ; seul le code a été vérifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risorse usano un sigillo precedente che macOS non può verificare, quindi è stato verificato solo il codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リソースにはmacOSで確認できない古いシールが使われているため、コードのみが検証されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리소스가 macOS에서 확인할 수 없는 이전 봉인 방식을 사용하므로 코드만 확인했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bronnen gebruiken een ouder zegel dat macOS niet kan controleren, dus alleen de code is geverifieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasoby używają starszej pieczęci, której system macOS nie może sprawdzić, więc zweryfikowano tylko kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os recursos usam um selo antigo que o macOS não consegue verificar, então apenas o código foi verificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ресурсы защищены устаревшей печатью, которую macOS не может проверить, поэтому проверен только код."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resurserna använder en äldre försegling som macOS inte kan kontrollera, så bara koden verifierades."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynakları macOS’in denetleyemediği eski bir mühür kullanıyor, bu nedenle yalnızca kod doğrulandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ресурси мають печатку старого формату, яку macOS не може перевірити, тож перевірено лише код."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其资源使用了macOS无法检查的旧式封签，因此仅验证了代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其資源使用macOS無法檢查的舊式封印，因此只驗證了程式碼。"
          }
        }
      }
    },
