    "Requested, but relocations were stripped, so Windows can’t move it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angefordert, aber die Relokationen wurden entfernt, daher kann Windows es nicht verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήθηκε, αλλά οι μετατοπίσεις αφαιρέθηκαν, οπότε τα Windows δεν μπορούν να το μετακινήσουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado, pero se eliminaron las reubicaciones, así que Windows no puede moverlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandée, mais les relocalisations ont été supprimées : Windows ne peut pas le déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto, ma le rilocazioni sono state rimosse, quindi Windows non può spostarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求されていますが、再配置情報が削除されているため、Windowsは移動できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청되었지만 재배치 정보가 제거되어 Windows에서 이동할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangevraagd, maar de relocaties zijn verwijderd, dus Windows kan het niet verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądane, ale relokacje zostały usunięte, więc Windows nie może go przenieść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado, mas as realocações foram removidas, então o Windows não pode movê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошено, но таблица перемещений удалена, поэтому Windows не может переместить файл."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
