          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signerad med ett certifikat som inte leder till Apple. Installeraren behandlar det som ett osignerat paket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’a ulaşmayan bir sertifikayla imzalanmış. Yükleyici bunu imzalanmamış bir paket gibi değerlendirir."
