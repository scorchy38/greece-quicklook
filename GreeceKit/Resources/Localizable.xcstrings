    "Greece can’t reproject %@ (%@), so it’s drawn in its own coordinates without a basemap." : {
      "comment" : "Notice on a map. The arguments are a coordinate system and its projection, such as “World Robinson” and “Robinson”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece kann %@ (%@) nicht umprojizieren, daher wird es in eigenen Koordinaten ohne Basiskarte gezeichnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Greece δεν μπορεί να επαναπροβάλει το %@ (%@), οπότε σχεδιάζεται στις δικές του συντεταγμένες χωρίς βασικό χάρτη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece no puede reproyectar %@ (%@), así que se dibuja en sus propias coordenadas sin mapa base."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece ne peut pas reprojeter %@ (%@) : la carte est dessinée dans ses propres coordonnées, sans fond de carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece non può riproiettare %@ (%@), quindi viene disegnato nelle sue coordinate senza mappa di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greeceは%1$@（%2$@）を再投影できないため、ベースマップなしで独自の座標で描画しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece에서 %@(%@)을(를) 재투영할 수 없으므로 기본 지도 없이 자체 좌표로 그립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece kan %@ (%@) niet herprojecteren, dus het wordt in de eigen coördinaten getekend zonder basiskaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece nie może przeliczyć odwzorowania %@ (%@), więc mapa jest rysowana we własnych współrzędnych bez mapy podkładowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Greece não consegue reprojetar %@ (%@), por isso o mapa é desenhado nas próprias coordenadas, sem mapa base."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece не может перепроецировать %@ (%@), поэтому данные отображаются в собственных координатах без базовой карты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece kan inte projicera om %@ (%@), så den ritas i sina egna koordinater utan bakgrundskarta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece %@ (%@) sistemini dönüştüremediğinden veri, temel harita olmadan kendi koordinatlarında çiziliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece не може перепроєктувати %@ (%@), тому дані показано у власних координатах без базової карти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece无法重新投影%@（%@），因此会以其自身坐标绘制，不显示底图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greece無法重新投影%@（%@），因此會以其自身座標繪製，且不顯示底圖。"
          }
        }
      }
    },
