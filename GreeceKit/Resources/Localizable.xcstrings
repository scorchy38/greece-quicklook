    "Files changed after it was signed. macOS may refuse to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien wurden nach dem Signieren geändert. macOS öffnet es möglicherweise nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένα αρχεία άλλαξαν μετά την υπογραφή. Το macOS ενδέχεται να αρνηθεί να το ανοίξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay archivos que han cambiado después de la firma. Es posible que macOS se niegue a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des fichiers ont été modifiés après la signature. macOS peut refuser de l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni file sono stati modificati dopo la firma. macOS potrebbe rifiutarsi di aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名後にファイルが変更されています。macOSで開けない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명 후 파일이 변경되었습니다. macOS에서 열기를 거부할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden zijn na ondertekening gewijzigd. macOS weigert het mogelijk te openen."
