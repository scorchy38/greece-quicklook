        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписано сертифікатом, який не веде до Apple. Інсталятор вважає його пакетом без підпису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
