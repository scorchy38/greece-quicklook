    "Verified links open in the app without asking, once the website confirms the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfte Links werden ohne Nachfrage in der App geöffnet, sobald die Website die App bestätigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επαληθευμένοι σύνδεσμοι ανοίγουν στην εφαρμογή χωρίς ερώτηση, αφού ο ιστότοπος επιβεβαιώσει την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces verificados se abren en la app sin preguntar una vez que el sitio web confirma la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens vérifiés s’ouvrent dans l’app sans confirmation, une fois que le site web a validé l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I link verificati si aprono nell’app senza chiedere, dopo che il sito web ha confermato l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証済みのリンクは、Webサイトがアプリを承認すると、尋ねずにアプリで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 사이트에서 앱을 확인하면 확인된 링크는 묻지 않고 앱에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geverifieerde links openen zonder te vragen in de app zodra de website de app bevestigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweryfikowane linki otwierają się w aplikacji bez pytania, gdy witryna potwierdzi aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os links verificados abrem no app sem perguntar, depois que o site confirma o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвержденные ссылки открываются в приложении без запроса, если сайт подтверждает приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifierade länkar öppnas i appen utan att fråga när webbplatsen har bekräftat appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web sitesi uygulamayı onayladığında doğrulanmış bağlantılar sormadan uygulamada açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірені посилання відкриваються в програмі без запиту, щойно вебсайт підтвердить програму."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网站确认此App后，已验证的链接会直接在App中打开，不再询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網站確認此App後，已驗證的連結會直接在App中打開，不會詢問。"
          }
        }
      }
    },
