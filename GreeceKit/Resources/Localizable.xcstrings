    "Encrypted with %@. Its files can only be read with the password." : {
      "comment" : "Badge tooltip. The argument is an encryption algorithm, such as “AES-256”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ verschlüsselt. Die Dateien sind nur mit dem Passwort lesbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρυπτογραφημένο με %@. Τα αρχεία του διαβάζονται μόνο με το συνθηματικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encriptada con %@. Sus archivos solo se pueden leer con la contraseña."
