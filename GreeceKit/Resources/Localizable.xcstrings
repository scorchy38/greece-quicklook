    "There’s no Authenticode signature, so nothing says who made this file or whether it changed since." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Authenticode-Signatur, daher ist nicht belegt, wer diese Datei erstellt hat oder ob sie seitdem geändert wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει υπογραφή Authenticode, οπότε τίποτα δεν δείχνει ποιος δημιούργησε αυτό το αρχείο ή αν έχει αλλάξει από τότε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay firma Authenticode, así que nada indica quién creó este archivo ni si ha cambiado desde entonces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune signature Authenticode : rien n’indique qui a créé ce fichier ni s’il a été modifié depuis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è una firma Authenticode, quindi nulla indica chi ha creato questo file o se è stato modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode署名がないため、このファイルの作成者や、その後変更されたかどうかを示すものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode 서명이 없으므로 누가 이 파일을 만들었는지, 이후에 변경되었는지 알 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen Authenticode-handtekening, dus niets geeft aan wie dit bestand heeft gemaakt of het sindsdien is gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak podpisu Authenticode, więc nic nie wskazuje, kto utworzył ten plik ani czy od tego czasu się zmienił."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há assinatura Authenticode, então nada indica quem criou este arquivo ou se ele foi alterado desde então."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписи Authenticode нет, поэтому неизвестно, кто создал этот файл и менялся ли он с тех пор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen Authenticode-signatur, så inget anger vem som har skapat filen eller om den har ändrats sedan dess."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode imzası yok; bu nedenle bu dosyayı kimin yaptığı veya o zamandan beri değişip değişmediği bilinemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпису Authenticode немає, тож невідомо, хто створив цей файл і чи змінювався він відтоді."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有Authenticode签名，因此无法得知此文件的制作者，也无法得知它此后是否有过更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有Authenticode簽名，因此無法得知此檔案的製作者，也無法得知它之後是否被更改。"
          }
        }
      }
    },
    "There’s no preview for this kind of file." : {
