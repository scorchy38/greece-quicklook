    "Installs a certificate authority. If trusted, it can intercept encrypted connections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert eine Zertifizierungsinstanz. Wenn ihr vertraut wird, kann sie verschlüsselte Verbindungen abfangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκαθιστά μια αρχή πιστοποίησης. Αν θεωρηθεί αξιόπιστη, μπορεί να υποκλέπτει κρυπτογραφημένες συνδέσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala una autoridad de certificación. Si se considera de confianza, puede interceptar conexiones encriptadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installe une autorité de certification. Si elle est approuvée, elle peut intercepter les connexions chiffrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa un’autorità di certificazione. Se considerata attendibile, può intercettare le connessioni crittografate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証局をインストールします。信頼されている場合、暗号化された接続を傍受できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증 기관을 설치합니다. 신뢰하면 암호화된 연결을 가로챌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeert een certificaatautoriteit. Als die wordt vertrouwd, kan deze versleutelde verbindingen onderscheppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluje urząd certyfikacji. Jeśli zostanie uznany za zaufany, może przechwytywać szyfrowane połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala uma autoridade de certificação. Se for confiável, pode interceptar conexões criptografadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливает центр сертификации. Если ему доверять, он сможет перехватывать зашифрованные подключения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installerar en certifikatutfärdare. Om den är betrodd kan den avlyssna krypterade anslutningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sertifika otoritesi yükler. Güvenilirse şifreli bağlantıların arasına girebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсталює центр сертифікації. Якщо йому довіряти, він може перехоплювати зашифровані зʼєднання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装证书颁发机构。如果受信任，它可以拦截加密连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝憑證授權機構。若受信任，便可攔截加密連線。"
          }
        }
      }
    },
