    "Authenticode signed by %@. Greece can’t confirm that Windows trusts this certificate." : {
      "comment" : "Badge tooltip. The argument is the signer’s organization or name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode-signiert von %@. Greece kann nicht bestätigen, dass Windows diesem Zertifikat vertraut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπογραφή Authenticode από %@. Το Greece δεν μπορεί να επιβεβαιώσει ότι τα Windows θεωρούν αξιόπιστο αυτό το πιστοποιητικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmado con Authenticode por %@. Greece no puede confirmar que Windows confíe en este certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signé avec Authenticode par %@. Greece ne peut pas confirmer que Windows approuve ce certificat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmato con Authenticode da %@. Greece non può confermare che Windows consideri attendibile questo certificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@によるAuthenticode署名があります。Windowsがこの証明書を信頼しているかどうかはGreeceでは確認できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) Authenticode로 서명했습니다. Greece는 Windows에서 이 인증서를 신뢰하는지 확인할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode-ondertekend door %@. Greece kan niet bevestigen dat Windows dit certificaat vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis Authenticode: %@. Greece nie może potwierdzić, że Windows ufa temu certyfikatowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinado com Authenticode por %@. O Greece não consegue confirmar se o Windows confia neste certificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись Authenticode: %@. Greece не может подтвердить, что Windows доверяет этому сертификату."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authenticode-signerad av %@. Greece kan inte bekräfta att Windows litar på certifikatet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarafından Authenticode ile imzalanmış. Greece, Windows’un bu sertifikaya güvendiğini doğrulayamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підпис Authenticode: %@. Greece не може підтвердити, що Windows довіряє цьому сертифікату."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由%@进行Authenticode签名。Greece无法确认Windows是否信任此证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由「%@」進行Authenticode簽署。Greece無法確認Windows是否信任此憑證。"
          }
        }
      }
    },
