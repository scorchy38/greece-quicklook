    "Enterprise and Developer ID profiles aren’t limited to registered devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enterprise- und Developer ID-Profile sind nicht auf registrierte Geräte beschränkt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα εταιρικά προφίλ και τα προφίλ Developer ID δεν περιορίζονται σε καταχωρισμένες συσκευές."
