    "Administrators are asked for permission; other users run it normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratoren werden um Erlaubnis gefragt; andere Benutzer führen es normal aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στους διαχειριστές ζητείται άδεια· οι άλλοι χρήστες το εκτελούν κανονικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pide permiso a los administradores; los demás usuarios lo ejecutan con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation est demandée aux administrateurs ; les autres utilisateurs l’exécutent normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agli amministratori viene chiesta l’autorizzazione; gli altri utenti lo eseguono normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者には許可が求められます。ほかのユーザは通常どおり実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자에게는 권한을 요청하고, 다른 사용자는 일반적으로 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheerders wordt om toestemming gevraagd; andere gebruikers voeren het normaal uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorzy są pytani o zgodę; inni użytkownicy uruchamiają go normalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
