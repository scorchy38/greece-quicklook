    "Built for Intel only. On Apple silicon it needs Rosetta, which future versions of macOS won’t include." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Intel erstellt. Auf Macs mit Apple Chip ist Rosetta erforderlich, das künftige macOS-Versionen nicht mehr enthalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήθηκε μόνο για Intel. Σε Apple silicon χρειάζεται το Rosetta, το οποίο δεν θα περιλαμβάνεται σε μελλοντικές εκδόσεις του macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creado solo para Intel. En Apple silicon necesita Rosetta, que no se incluirá en futuras versiones de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu uniquement pour Intel. Sur Apple silicon, il nécessite Rosetta, que les futures versions de macOS n’incluront plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creato solo per Intel. Su Apple silicon richiede Rosetta, che le versioni future di macOS non includeranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intel専用にビルドされています。Appleシリコン搭載MacではRosettaが必要ですが、Rosettaは将来のバージョンのmacOSには含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intel 전용으로 빌드되었습니다. Apple Silicon에서는 Rosetta가 필요하며, 향후 macOS 버전에는 Rosetta가 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen gemaakt voor Intel. Op Apple silicon is Rosetta nodig, dat niet in toekomstige versies van macOS zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbudowano tylko dla procesorów Intel. Na Apple silicon wymaga Rosetty, której przyszłe wersje systemu macOS nie będą zawierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criado apenas para Intel. Em Apple silicon, requer o Rosetta, que as próximas versões do macOS não incluirão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создано только для Intel. На Apple silicon требуется Rosetta, которой не будет в будущих версиях macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byggd endast för Intel. På Apple silicon krävs Rosetta, som inte ingår i framtida versioner av macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Intel için derlenmiş. Apple silicon’da Rosetta gerektirir; macOS’in gelecek sürümleri Rosetta’yı içermeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створено лише для Intel. На Apple silicon потрібна Rosetta, якої не буде в майбутніх версіях macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅为Intel构建。在搭载Apple芯片的Mac上需要Rosetta，而未来版本的macOS将不再包含Rosetta。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅為Intel建構。在Apple晶片上需要Rosetta，而未來的macOS版本將不再包含Rosetta。"
          }
        }
      }
    },
