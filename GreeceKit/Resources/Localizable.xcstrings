    "Without the hardened runtime, other code can more easily inject into or debug this process." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Hardened Runtime kann sich anderer Code leichter in diesen Prozess einschleusen oder ihn debuggen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς το Hardened Runtime, άλλος κώδικας μπορεί πιο εύκολα να εισχωρήσει σε αυτήν τη διεργασία ή να την εκσφαλματώσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Hardened Runtime, otro código puede inyectarse en este proceso o depurarlo con más facilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans le Hardened Runtime, un autre code peut plus facilement s’injecter dans ce processus ou le déboguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Hardened Runtime, altro codice può più facilmente iniettarsi in questo processo o eseguirne il debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hardened Runtimeがないと、ほかのコードがこのプロセスにインジェクトしたり、デバッグしたりしやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강화된 런타임이 없으면 다른 코드가 이 프로세스에 더 쉽게 코드를 삽입하거나 디버그할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder de hardened runtime kan andere code zich makkelijker in dit proces injecteren of het debuggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez Hardened Runtime inny kod może łatwiej wstrzyknąć się do tego procesu lub go debugować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o hardened runtime, outro código pode se injetar neste processo ou depurá-lo com mais facilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Hardened Runtime другой код может легче внедряться в этот процесс или отлаживать его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan Hardened Runtime kan annan kod lättare injiceras i eller felsöka den här processen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlendirilmiş çalışma zamanı olmadan başka kodlar bu sürece daha kolay kod enjekte edebilir veya bu süreçte hata ayıklayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Hardened Runtime інший код може легше впроваджуватися в цей процес або налагоджувати його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有强化运行时，其他代码更容易注入或调试此进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若沒有強化執行階段，其他程式碼更容易注入此程序或為其除錯。"
          }
        }
      }
    },
