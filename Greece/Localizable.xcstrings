    "Previews are rendered on your Mac. Greece has no accounts, analytics or tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschauen werden auf deinem Mac erstellt. Greece hat keine Accounts, keine Analysen und kein Tracking."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι προεπισκοπήσεις δημιουργούνται στο Mac σας. Το Greece δεν έχει λογαριασμούς, ανάλυση ή παρακολούθηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las previsualizaciones se generan en tu Mac. Greece no tiene cuentas, análisis ni rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
