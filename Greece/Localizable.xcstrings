        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snelle weergave opent SVG in de webviewer van Apple, nog vóór elke extensie. Greece toont SVG's in archieven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybki przegląd otwiera pliki SVG we wbudowanej przeglądarce internetowej, zanim użyje jakiegokolwiek rozszerzenia. Greece pokazuje pliki SVG w archiwach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Visualização Rápida abre SVG no visualizador web da Apple, antes de qualquer extensão. O Greece mostra SVGs dentro de arquivos comprimidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый просмотр открывает SVG в средстве Apple для просмотра веб-контента — раньше любого расширения. Greece показывает SVG внутри архивов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överblick öppnar SVG i Apples webbvisare, före alla tillägg. Greece visar SVG-filer i arkiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göz At, SVG dosyalarını herhangi bir genişletmeden önce Apple’ın web görüntüleyicisinde açar. Greece, arşivlerin içindeki SVG’leri gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
