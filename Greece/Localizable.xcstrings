    "Click a column header to sort. Select rows and press ⌘C to copy them as tab-separated text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine Spaltenüberschrift, um zu sortieren. Wähle Zeilen aus und drücke ⌘C, um sie als tabulatorgetrennten Text zu kopieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κλικ σε μια κεφαλίδα στήλης για ταξινόμηση. Επιλέξτε σειρές και πατήστε ⌘C για να τις αντιγράψετε ως κείμενο διαχωρισμένο με στηλοθέτες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el encabezado de una columna para ordenar. Selecciona filas y pulsa ⌘C para copiarlas como texto separado por tabulaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un en-tête de colonne pour trier. Sélectionnez des rangs et appuyez sur ⌘C pour les copier sous forme de texte séparé par des tabulations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull’intestazione di una colonna per ordinare. Seleziona delle righe e premi ⌘C per copiarle come testo separato da tabulazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列見出しをクリックすると並べ替えられます。行を選択して⌘Cを押すと、タブ区切りのテキストとしてコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 머리말을 클릭하여 정렬합니다. 행을 선택하고 ⌘C를 누르면 탭으로 구분된 텍스트로 복사됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op een kolomkop om te sorteren. Selecteer rijen en druk op ⌘C om ze als door tabs gescheiden tekst te kopiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij w nagłówek kolumny, aby sortować. Zaznacz wiersze i naciśnij ⌘C, aby skopiować je jako tekst rozdzielany tabulatorami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no cabeçalho de uma coluna para ordenar. Selecione linhas e pressione ⌘C para copiá-las como texto separado por tabulações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отсортировать таблицу, нажмите заголовок столбца. Чтобы скопировать строки как текст с разделителями-табуляциями, выберите их и нажмите ⌘C."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på en kolumnrubrik om du vill sortera. Markera rader och tryck på ⌘C om du vill kopiera dem som tabbavgränsad text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralamak için bir sütun başlığını tıklayın. Satırları seçip ⌘C tuşlarına basarak tab ile ayrılmış metin olarak kopyalayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відсортувати таблицю, клацніть заголовок стовпця. Щоб скопіювати рядки як текст, розділений табуляціями, виберіть їх і натисніть ⌘C."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按列标题可排序。选择行并按下⌘C，即可将其拷贝为以制表符分隔的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下直欄標題來排序。選取列並按下⌘C，即可將其拷貝為以定位符號分隔的文字。"
          }
        }
      }
    },
    "Code" : {
