    "%@ follows your Mac’s appearance. Choose a variant to keep it light or dark." : {
      "comment" : "The argument is a code theme’s name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ folgt dem Erscheinungsbild deines Mac. Wähle eine Variante, damit das Thema immer hell oder dunkel bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ ακολουθεί την εμφάνιση του Mac σας. Επιλέξτε μια παραλλαγή για να παραμένει πάντα ανοιχτόχρωμο ή σκούρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se adapta al aspecto de tu Mac. Elige una variante para que sea siempre claro u oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ suit l’apparence de votre Mac. Choisissez une variante pour l’afficher toujours en clair ou en sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ segue l’aspetto del Mac. Scegli una variante per mantenerlo sempre chiaro o scuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はMacの外観モードに従います。常にライトまたはダークで表示するには、バリエーションを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Mac의 화면 모드를 따릅니다. 항상 라이트 또는 다크로 표시하려면 변형을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ volgt de weergave van je Mac. Kies een variant om het thema altijd licht of donker te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motyw %@ dopasowuje się do wyglądu Maca. Wybierz wariant, aby był zawsze jasny lub ciemny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ segue a aparência do Mac. Escolha uma variante para mantê-lo sempre claro ou escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема «%@» меняется вместе с оформлением Mac. Чтобы она всегда была светлой или темной, выберите вариант."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ följer utseendet på din Mac. Välj en variant om du vill att det alltid ska vara ljust eller mörkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Mac’inizin görünüşüne uyar. Her zaman açık veya koyu kalması için bir varyant seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема «%@» змінюється разом із виглядом Mac. Щоб вона завжди була світлою або темною, виберіть варіант."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”跟随Mac的外观。若要始终保持浅色或深色，请选择一个变体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」會跟隨Mac的外觀。若要一律保持淺色或深色，請選擇變體。"
          }
        }
      }
    },
    "%@ is a dark theme and stays dark in either appearance." : {
      "comment" : "The argument is a code theme’s name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein dunkles Thema und bleibt unabhängig vom Erscheinungsbild dunkel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
