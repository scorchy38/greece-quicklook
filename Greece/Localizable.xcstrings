          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Άμεση προβολή χρησιμοποιεί το %@. Κάντε κλικ στην «Επισκευή» για να χρησιμοποιηθεί αυτό το αντίγραφο και να αφαιρεθούν τα άλλα."
          }
        },
        "es" : {
