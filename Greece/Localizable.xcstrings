    "Select any file in Finder and press Space. Settings apply to the next preview you open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine beliebige Datei im Finder aus und drücke die Leertaste. Einstellungen gelten ab der nächsten Vorschau, die du öffnest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε οποιοδήποτε αρχείο στο Finder και πατήστε το πλήκτρο διαστήματος. Οι ρυθμίσεις εφαρμόζονται στην επόμενη προεπισκόπηση που θα ανοίξετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona cualquier archivo en el Finder y pulsa la barra espaciadora. Los ajustes se aplican a la siguiente previsualización que abras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un fichier dans le Finder et appuyez sur la barre d’espace. Les réglages s’appliquent au prochain aperçu que vous ouvrez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un file nel Finder e premi la barra spaziatrice. Le impostazioni si applicano alla prossima anteprima che apri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderでファイルを選択して、スペースバーを押してください。設定は次に開くプレビューから適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에서 파일을 선택하고 스페이스 바를 누르십시오. 설정은 다음에 여는 미리보기부터 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer een bestand in de Finder en druk op de spatiebalk. Instellingen gelden vanaf de volgende voorvertoning die je opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz dowolny plik w Finderze i naciśnij spację. Ustawienia zostaną zastosowane do następnego otwartego podglądu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione qualquer arquivo no Finder e pressione a barra de espaço. Os ajustes se aplicam à próxima pré-visualização que você abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите любой файл в Finder и нажмите пробел. Настройки применяются при следующем открытии просмотра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera en fil i Finder och tryck på mellanslag. Inställningarna gäller för nästa förhandsvisning du öppnar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’da herhangi bir dosyayı seçip boşluk çubuğuna basın. Ayarlar, açacağınız bir sonraki önizlemede uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть будь-який файл у Finder і натисніть пробіл. Параметри застосовуються до наступного відкритого перегляду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“访达”中选择任意文件并按下空格键。设置将应用于你打开的下一个预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Finder中選取任一檔案並按下空白鍵。設定會套用到你打開的下一個預覽。"
          }
        }
      }
    },
