    "Each opens in the real Quick Look panel, exactly as Finder shows it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Beispiel öffnet sich in der echten Übersicht – genau wie im Finder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το καθένα ανοίγει στο πραγματικό παράθυρο Άμεσης προβολής, ακριβώς όπως το εμφανίζει το Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada archivo se abre en el panel real de “Vista rápida”, tal como lo muestra el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun s’ouvre dans la vraie fenêtre Coup d’œil, exactement comme dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno si apre nella vera finestra di Visualizzazione rapida, esattamente come nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いずれも実際のクイックルックパネルで、Finderでの表示とまったく同じように開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목은 Finder에서 보는 것과 똑같이 실제 훑어보기 패널에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk voorbeeld opent in het echte venster van Snelle weergave, precies zoals de Finder het toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy otwiera się w prawdziwym panelu Szybkiego przeglądu, dokładnie tak, jak w Finderze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada arquivo é aberto no painel real da Visualização Rápida, exatamente como o Finder o mostra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый пример открывается в настоящем окне Быстрого просмотра — точно так же, как в Finder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla öppnas i den riktiga Överblick-panelen, precis som Finder visar dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her biri, tıpkı Finder’daki gibi gerçek Göz At penceresinde açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен зразок відкривається в справжньому вікні Швидкого перегляду — так само, як у Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个示例都会在真正的“快速查看”面板中打开，与在“访达”中看到的完全一致。"
