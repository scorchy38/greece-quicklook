    "A ring of islands in the Aegean, reached by %@ from Piraeus each morning." : {
      "comment" : "Theme thumbnail: the sample sentence; the argument is the linked word “ferry”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Inselring in der Ägäis, jeden Morgen per %@ ab Piräus erreichbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας κύκλος νησιών στο Αιγαίο, όπου φτάνει κάθε πρωί το %@ από τον Πειραιά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anillo de islas del Egeo al que cada mañana se llega en %@ desde El Pireo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anneau d’îles en mer Égée, que l’on rejoint chaque matin en %@ depuis le Pirée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anello di isole nell’Egeo, raggiungibili ogni mattina in %@ dal Pireo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エーゲ海に輪のように連なる島々。毎朝ピレウスから%@で渡れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에게해에 고리처럼 이어진 섬들로, 매일 아침 피레우스에서 %@로 갈 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ring van eilanden in de Egeïsche Zee, elke ochtend vanuit Piraeus per %@ bereikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierścień wysp na Morzu Egejskim, do których co rano płynie %@ z Pireusu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um anel de ilhas no Egeu, aonde se chega de %@ saindo do Pireu todas as manhãs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кольцо островов в Эгейском море, куда каждое утро ходит %@ из Пирея."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ring av öar i Egeiska havet som nås med %@ från Pireus varje morgon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ege’de, her sabah Pire’den %@ ile ulaşılan bir ada halkası."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кільце островів у Егейському морі, куди щоранку ходить %@ з Пірея."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱琴海上的环形群岛，每天清晨从比雷埃夫斯乘%@前往。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愛琴海上的環狀群島，每天清晨從比雷埃夫斯搭%@前往。"
          }
        }
      }
    },
