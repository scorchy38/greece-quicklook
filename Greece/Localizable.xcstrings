    "More than one extension claims this type; Quick Look shows only one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als eine Erweiterung ist für diesen Dateityp registriert. Die Übersicht verwendet nur eine davon."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περισσότερες από μία επεκτάσεις διεκδικούν αυτόν τον τύπο· η Άμεση προβολή εμφανίζει μόνο μία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más de una extensión admite este tipo; “Vista rápida” solo muestra una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs extensions prennent en charge ce type de fichier ; Coup d’œil n’en utilise qu’une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più estensioni gestiscono questo tipo di file; Visualizzazione rapida ne usa solo una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の機能拡張がこのファイルタイプに対応していますが、クイックルックで使用されるのは1つだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 확장 프로그램이 이 파일 유형을 처리하지만 훑어보기는 하나만 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer dan één extensie is geregistreerd voor dit bestandstype; Snelle weergave gebruikt er maar één."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej niż jedno rozszerzenie deklaruje obsługę tego typu. Szybki przegląd używa tylko jednego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais de uma extensão é compatível com este tipo; a Visualização Rápida mostra apenas uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержку этого типа заявляют несколько расширений, но Быстрый просмотр использует только одно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler än ett tillägg gör anspråk på den här typen. Överblick visar bara ett."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu türü birden fazla genişletme üstleniyor; Göz At yalnızca birini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтримку цього типу заявляють кілька розширень, але Швидкий перегляд використовує лише одне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
