    "Every reading theme has a light and a dark version and follows your Mac’s appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Lesethema hat eine helle und eine dunkle Variante und folgt dem Erscheinungsbild deines Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε θέμα ανάγνωσης έχει ανοιχτόχρωμη και σκούρα παραλλαγή και ακολουθεί την εμφάνιση του Mac σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los temas de lectura tienen una versión clara y otra oscura, y se adaptan al aspecto de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque thème de lecture existe en version claire et sombre, et suit l’apparence de votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tema di lettura ha una versione chiara e una scura e segue l’aspetto del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての閲覧用テーマにライトとダークのバージョンがあり、Macの外観モードに従って切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 읽기 테마에는 라이트 및 다크 버전이 있으며 Mac의 화면 모드를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk leesthema heeft een lichte en een donkere versie en volgt de weergave van je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy motyw do czytania ma wersję jasną i ciemną oraz dopasowuje się do wyglądu Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os temas de leitura têm uma versão clara e uma escura e seguem a aparência do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждой темы для чтения есть светлый и темный варианты, которые меняются вместе с оформлением Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla lästeman har en ljus och en mörk version och följer utseendet på din Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her okuma temasının açık ve koyu bir varyantı vardır ve Mac’inizin görünüşüne uyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна тема для читання має світлий і темний варіанти, які змінюються разом із виглядом Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个阅读主题都有浅色和深色版本，并会跟随Mac的外观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個閱讀主題都有淺色和深色版本，並會跟隨Mac的外觀。"
          }
        }
      }
    },
