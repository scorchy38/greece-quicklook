    "Type `greece file.md` in Terminal, or pipe text into `greece`." : {
      "comment" : "Keep the Markdown code spans: `greece` is the command",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib `greece file.md` im Terminal ein oder leite Text per Pipe an `greece` weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολογήστε `greece file.md` στο Τερματικό ή διοχετεύστε κείμενο στο `greece`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe `greece file.md` en Terminal o canaliza texto hacia `greece`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez `greece file.md` dans Terminal, ou redirigez du texte vers `greece`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita `greece file.md` in Terminale o invia del testo a `greece` tramite pipe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルで`greece file.md`と入力するか、テキストを`greece`にパイプしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널에서 `greece file.md`를 입력하거나 텍스트를 `greece`에 파이프로 전달하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ `greece file.md` in Terminal of stuur tekst via een pipe naar `greece`."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz `greece file.md` w Terminalu lub przekaż tekst do `greece` potokiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite `greece file.md` no Terminal ou envie texto por pipe para o `greece`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите `greece file.md` в Терминале или передайте текст команде `greece` через конвейер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv `greece file.md` i Terminal eller skicka text till `greece` via en pipe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal’de `greece file.md` yazın veya `greece` komutuna metin aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть `greece file.md` у Терміналі або передайте текст команді `greece` через конвеєр."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“终端”中输入`greece file.md`，或通过管道将文本传给`greece`。"
          }
        },
        "zh-Hant" : {
