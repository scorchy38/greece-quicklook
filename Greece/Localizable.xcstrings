    "Check opens a sample in the real Quick Look panel and reports which viewer macOS picked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prüfen“ öffnet ein Beispiel in der echten Übersicht und meldet, welchen Viewer macOS gewählt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κουμπί «Έλεγχος» ανοίγει ένα δείγμα στο πραγματικό παράθυρο Άμεσης προβολής και αναφέρει ποιο πρόγραμμα προβολής επέλεξε το macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón Comprobar abre una muestra en el panel real de “Vista rápida” e indica qué visor ha elegido macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton Vérifier ouvre un exemple dans la vraie fenêtre Coup d’œil et indique le visualiseur choisi par macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante Verifica apre un file di esempio nella vera finestra di Visualizzazione rapida e indica quale visualizzatore ha scelto macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“確認”をクリックすると、実際のクイックルックパネルでサンプルが開き、macOSが選択したビューアが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘확인’을 클릭하면 실제 훑어보기 패널에서 샘플이 열리고 macOS가 선택한 뷰어가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Controleer' opent een voorbeeld in het echte venster van Snelle weergave en meldt welke viewer macOS heeft gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk Sprawdź otwiera przykład w prawdziwym panelu Szybkiego przeglądu i pokazuje, którą przeglądarkę wybrał system macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão Verificar abre uma amostra no painel real da Visualização Rápida e informa qual visualizador o macOS escolheu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Проверить» открывает пример файла в настоящем окне Быстрого просмотра и показывает, какое средство просмотра выбрано в macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera öppnar ett exempel i den riktiga Överblick-panelen och visar vilken visare macOS valde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetle düğmesi bir örneği gerçek Göz At penceresinde açar ve macOS’in hangi görüntüleyiciyi seçtiğini bildirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Перевірити» відкриває зразок файлу в справжньому вікні Швидкого перегляду й показує, який переглядач вибрано в macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“检查”会在真正的“快速查看”面板中打开示例，并报告macOS选用了哪个查看器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「檢查」會在真正的「快速查看」面板中打開範例，並回報macOS選用了哪個檢視器。"
          }
        }
      }
    },
