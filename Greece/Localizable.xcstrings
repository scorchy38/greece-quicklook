    "Quick Look always opens CSV in Apple’s Office previewer, before any extension." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersicht öffnet CSV immer in der Office-Vorschau von Apple – noch vor jeder Erweiterung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Άμεση προβολή ανοίγει πάντα τα αρχεία CSV στο πρόγραμμα προεπισκόπησης Office της Apple, πριν από οποιαδήποτε επέκταση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vista rápida” siempre abre los CSV con el visor de Office de Apple, antes que cualquier extensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coup d’œil ouvre toujours les fichiers CSV avec le visualiseur Office d’Apple, avant toute extension."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizzazione rapida apre sempre i file CSV con il visualizzatore Office di Apple, prima di qualsiasi estensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックルックでは、機能拡張よりも優先して、常にAppleのOfficeプレビューアでCSVが開かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훑어보기는 확장 프로그램보다 먼저 항상 Apple의 Office 미리보기 도구로 CSV를 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snelle weergave opent CSV altijd in de Office-voorvertoning van Apple, nog vóór elke extensie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybki przegląd zawsze otwiera pliki CSV we wbudowanym podglądzie dokumentów Office, zanim użyje jakiegokolwiek rozszerzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
