<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>Paris sampler</name>
  <open>1</open>
  <description><![CDATA[<p>Synthetic KML 2.2 fixture: styles, folders, geometry types, ExtendedData, gx:Track and HTML descriptions (one is hostile, for sanitiser tests).</p>]]></description>
  <LookAt><longitude>2.3376</longitude><latitude>48.8606</latitude><altitude>0</altitude><heading>0</heading><tilt>0</tilt><range>9000</range><altitudeMode>relativeToGround</altitudeMode></LookAt>
  <Style id="landmarkNormal">
    <IconStyle><color>ff0000ff</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon><hotSpot x="32" y="1" xunits="pixels" yunits="pixels"/></IconStyle>
    <LabelStyle><scale>0.0</scale></LabelStyle>
  </Style>
  <Style id="landmarkHighlight">
    <IconStyle><color>ff00aaff</color><scale>1.4</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon><hotSpot x="32" y="1" xunits="pixels" yunits="pixels"/></IconStyle>
    <LabelStyle><scale>1.0</scale></LabelStyle>
  </Style>
  <StyleMap id="landmarkMap">
    <Pair><key>normal</key><styleUrl>#landmarkNormal</styleUrl></Pair>
    <Pair><key>highlight</key><styleUrl>#landmarkHighlight</styleUrl></Pair>
  </StyleMap>
  <Style id="pushpin">
    <IconStyle><color>ff00ffff</color><scale>1.0</scale><Icon><href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon><hotSpot x="20" y="2" xunits="pixels" yunits="pixels"/></IconStyle>
  </Style>
  <Style id="walkLine">
    <LineStyle><color>ffd18802</color><width>4</width></LineStyle>
  </Style>
  <Style id="parkArea">
    <LineStyle><color>ff2f8f2f</color><width>2</width></LineStyle>
    <PolyStyle><color>7f3fbf3f</color><fill>1</fill><outline>1</outline></PolyStyle>
  </Style>
  <Style id="islandArea">
    <IconStyle><scale>0.8</scale><Icon><href>http://maps.google.com/mapfiles/kml/shapes/info-i.png</href></Icon></IconStyle>
    <LineStyle><color>ff7f3f00</color><width>1.5</width></LineStyle>
    <PolyStyle><color>66c08040</color></PolyStyle>
  </Style>
  <Folder>
    <name>Landmarks</name>
    <open>1</open>
    <Placemark>
      <name>Eiffel Tower</name>
      <description><![CDATA[<p>Wrought-iron lattice tower, completed in <b>1889</b>.</p><p><a href="https://en.wikipedia.org/wiki/Eiffel_Tower">Read more on Wikipedia</a></p>]]></description>
      <styleUrl>#landmarkMap</styleUrl>
      <ExtendedData>
        <Data name="height_m"><displayName>Height M</displayName><value>330</value></Data>
        <Data name="opened"><displayName>Opened</displayName><value>1889-03-31</value></Data>
        <Data name="architect"><displayName>Architect</displayName><value>Stephen Sauvestre</value></Data>
      </ExtendedData>
      <Point><coordinates>2.294481,48.858370,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Louvre Pyramid</name>
      <description><![CDATA[<p>Glass and metal pyramid in the main courtyard of the Louvre.</p><img src="https://example.com/images/louvre-pyramid.jpg" width="160" alt="Remote image (should not load)">]]></description>
      <styleUrl>#landmarkMap</styleUrl>
      <ExtendedData>
        <Data name="height_m"><displayName>Height M</displayName><value>21.6</value></Data>
        <Data name="opened"><displayName>Opened</displayName><value>1989</value></Data>
      </ExtendedData>
      <Point><coordinates>2.335885,48.861016,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Notre-Dame de Paris</name>
      <description><![CDATA[<p>Sanitiser test: the next script must not run.</p><script>alert(1)</script><p>Broken image with handler: <img src=x onerror=alert(1)></p><p><a href="javascript:alert(1)">javascript: link</a> and a <a href="https://www.notredamedeparis.fr/">normal link</a>.</p><div onclick="alert(1)" style="color:red">click handler</div>]]></description>
      <styleUrl>#landmarkMap</styleUrl>
      <ExtendedData>
        <Data name="rebuilt"><displayName>Rebuilt</displayName><value>2024-12-07</value></Data>
      </ExtendedData>
      <Point><coordinates>2.349902,48.852968,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Sacré-Cœur</name>
      <description><![CDATA[<p>Basilica on the summit of Montmartre, <i>the highest point in the city</i>.</p>]]></description>
      <styleUrl>#pushpin</styleUrl>
      <ExtendedData>
        <Data name="elevation_m"><displayName>Elevation M</displayName><value>130</value></Data>
      </ExtendedData>
      <Point><coordinates>2.343076,48.886705,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Arc de Triomphe</name>
      <description><![CDATA[<p>Honours those who fought for France. Unicode: « Place Charles-de-Gaulle » — 12 avenues.</p>]]></description>
      <styleUrl>#pushpin</styleUrl>
      <Point><coordinates>2.295028,48.873792,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Panthéon</name>
      <description><![CDATA[<p>Neoclassical mausoleum in the Latin Quarter.</p>]]></description>
      <styleUrl>#pushpin</styleUrl>
      <Point><coordinates>2.346271,48.846222,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Musée d'Orsay</name>
      <description><![CDATA[<p>Museum in a former railway station.</p><ul><li>Impressionism</li><li>Post-Impressionism</li></ul>]]></description>
      <styleUrl>#landmarkMap</styleUrl>
      <Point><coordinates>2.326561,48.859961,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Centre Pompidou</name>
      <description><![CDATA[<table><tr><th>Opened</th><td>1977</td></tr><tr><th>Architects</th><td>Piano &amp; Rogers</td></tr></table>]]></description>
      <styleUrl>#landmarkMap</styleUrl>
      <Point><coordinates>2.352245,48.860642,0</coordinates></Point>
    </Placemark>
  </Folder>
  <Folder>
    <name>Walks</name>
    <Placemark>
      <name>Along the Seine (left bank)</name>
      <description>Eiffel Tower to Notre-Dame along the quais, about 5 km.</description>
      <styleUrl>#walkLine</styleUrl>
      <ExtendedData><Data name="distance_km"><value>5.1</value></Data><Data name="surface"><value>paved</value></Data></ExtendedData>
