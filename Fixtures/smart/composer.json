{
    "name": "greece/preview-api",
    "description": "Server-side preview generation for the Greece web app.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "ext-intl": "*",
        "laravel/framework": "^11.31",
        "league/commonmark": "^2.5",
        "spatie/browsershot": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "post-install-cmd": ["@php artisan key:generate --ansi", "@php artisan migrate --graceful"]
    }
}
