1 ICON "hello.ico"
1 24 "hello.manifest"

1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x2
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Greece Fixtures"
      VALUE "FileDescription", "Greece Test App"
      VALUE "FileVersion", "1.2.3.4"
      VALUE "ProductName", "Hello Greece"
      VALUE "ProductVersion", "1.2"
      VALUE "OriginalFilename", "hello.exe"
      VALUE "LegalCopyright", "Public domain"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
